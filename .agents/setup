#!/usr/bin/env bash
set -euo pipefail

# Debian 12 ships FFmpeg 5; the media crate and export CLI require FFmpeg 9.
packages=(build-essential pkg-config clang cmake nasm libx264-dev
          libmp3lame-dev libvpx-dev libfreetype6-dev libharfbuzz-dev libasound2-dev
          libgtk-3-dev)
missing=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo apt-get install -y "${missing[@]}"
fi

if ! command -v mise >/dev/null; then
    if [[ ! -x "$HOME/.local/bin/mise" ]]; then
        curl -fsSL https://mise.run | sh
    fi
    sudo ln -sf "$HOME/.local/bin/mise" /usr/local/bin/mise
fi
mise trust
mise install

if ! pkg-config --atleast-version=63 libavcodec 2>/dev/null ||
   ! ffmpeg -version | grep -q '^ffmpeg version 9\.' ||
   ! ffmpeg -version | grep -q -- '--enable-libmp3lame' ||
   ! ffmpeg -version | grep -q -- '--enable-libvpx'; then
    build=$(mktemp -d)
    trap 'rm -rf "$build"' EXIT
    curl -fsSL https://ffmpeg.org/releases/ffmpeg-9.0.tar.xz -o "$build/ffmpeg.tar.xz"
    echo "7f607a00dd0d28a729d5a4811205812eef01cf6ef6155025febb6f36a9062d52  $build/ffmpeg.tar.xz" | sha256sum -c -
    tar -xJf "$build/ffmpeg.tar.xz" -C "$build"
    (
        cd "$build/ffmpeg-9.0"
        ./configure --prefix=/usr/local --enable-shared --disable-static \
            --disable-doc --disable-debug --disable-ffplay --enable-gpl \
            --enable-libx264 --enable-libmp3lame --enable-libvpx \
            --enable-libfreetype --enable-libharfbuzz
        make -j"$(nproc)"
        sudo make install
    )
    sudo ldconfig
fi

mise exec -- cargo fetch --locked
