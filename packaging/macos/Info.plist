<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Eddie</string>
	<key>CFBundleDisplayName</key>
	<string>Eddie</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.burgesstg.eddie</string>
	<key>CFBundleExecutable</key>
	<string>eddie</string>
	<key>CFBundleIconFile</key>
	<string>eddie</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- bundle.sh sets both from the workspace version in Cargo.toml. -->
	<key>CFBundleShortVersionString</key>
	<string>0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<!-- bundle.sh sets it to the macOS the bundled libraries were built for. -->
	<key>LSMinimumSystemVersion</key>
	<string>0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Eddie project</string>
			<key>CFBundleTypeIconFile</key>
			<string>eddie-project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.burgesstg.eddie.project</string>
			</array>
		</dict>
		<!-- Media is imported, never rewritten, and Eddie does not ask to be
		     the app that opens it by default. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Media</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.burgesstg.eddie.project</string>
			<key>UTTypeDescription</key>
			<string>Eddie project</string>
			<key>UTTypeIconFile</key>
			<string>eddie-project</string>
			<!-- Finder's icon view shows a thumbnail of the project's text
			     in place of this icon, and would for public.data too. -->
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>eddie</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- macOS has no type of its own for Matroska, so .mkv would not be
	     offered to Eddie without this. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.matroska.mkv</string>
			<key>UTTypeDescription</key>
			<string>Matroska video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkv</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
